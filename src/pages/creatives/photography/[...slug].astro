---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { getStorageImageUrl } from "../../../utils/storage";

export async function getStaticPaths() {
  const entries = await getCollection("photography");
  return entries.map((entry) => {
    const slug =
      (entry as { id: string; slug?: string }).slug ?? entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  pubDate,
  author,
  location,
  camera,
} = entry.data;
const imageUrl = getStorageImageUrl(entry.data.image);

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const metadata = {
  title,
  description: description ?? title,
};
---

<BaseLayout {metadata} section="Photography">
  <section class="px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="mx-auto max-w-3xl">
      <nav class="mb-6 text-sm">
        <a
          href="/creatives/photography"
          class="text-muted-foreground hover:text-primary"
        >
          ← Photography
        </a>
      </nav>

      <article class="overflow-hidden rounded-xl border border-border bg-card/60">
        {
          imageUrl && (
            <div class="border-b border-border bg-muted/30">
              <img
                src={imageUrl}
                alt={title}
                class="mx-auto max-h-[min(70vh,720px)] w-full object-contain"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )
        }

        <div class="px-6 py-8 sm:px-8">
          <header class="mb-6">
            <p class="text-sm text-muted-foreground">
              {formattedDate}
              {author && ` · ${author}`}
              {location && ` · ${location}`}
              {camera && ` · ${camera}`}
            </p>
            <h1
              class="font-heading mt-1 text-2xl font-bold tracking-tight text-foreground sm:text-3xl"
            >
              {title}
            </h1>
            {
              description && (
                <p class="mt-2 text-sm text-muted-foreground">{description}</p>
              )
            }
          </header>

          <div
            class="prose prose-lg dark:prose-invert max-w-none text-sm leading-relaxed prose-p:text-foreground prose-p:my-3 first:prose-p:mt-0 last:prose-p:mb-0"
          >
            <Content />
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
