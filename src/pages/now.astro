---
import BaseLayout from "../layouts/BaseLayout.astro";
import Headline from "../components/ui/Headline.astro";
import Tabs from "../components/ui/Tabs.astro";

const metadata = {
  title: "Now",
  description:
    "What I’m focused on right now — work, learning, reading, and small creative experiments.",
};

const nowTabs = [
  { id: "work", label: "Work" },
  { id: "research", label: "Research" },
  { id: "activities", label: "Activities" },
  { id: "off-script", label: "Off-script" },
] as const;

const p = (id: (typeof nowTabs)[number]["id"]) => `panel-now-${id}`;
---

<BaseLayout {metadata}>
  <section class="px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="mx-auto max-w-3xl space-y-8">
      <Headline
        tagline="Now"
        title="What I’m working on now"
        subtitle="Inspired by the /now page idea from Derek Sivers. I’ll try to keep this updated every month or two."
        classes={{
          container: "mb-4 text-left",
          title:
            "font-heading mb-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle: "text-sm text-muted-foreground",
        }}
      />

      <p class="text-xs text-muted-foreground">Last updated: March 2026</p>

      <Tabs tabs={[...nowTabs]} idPrefix="now">
        <div id={p("work")} data-tab-panel="work" class="text-sm leading-relaxed text-muted-foreground">
          <p>
            Building and refining AI systems for industrial monitoring and energy
            efficiency — especially around how operators actually interact with models in
            the control room.
          </p>
        </div>

        <div
          id={p("research")}
          data-tab-panel="research"
          class="text-sm leading-relaxed text-muted-foreground"
        >
          <p>
            Exploring time-series ML architectures, physics-informed models, and better
            ways to blend domain intuition with data-driven methods.
          </p>
        </div>

        <div
          id={p("activities")}
          data-tab-panel="activities"
          class="text-sm leading-relaxed text-muted-foreground"
        >
          <p>
            A mix of systems thinking, industrial automation, and books that have nothing
            to do with work but quietly change how I see it.
          </p>
        </div>

        <div
          id={p("off-script")}
          data-tab-panel="off-script"
          class="text-sm leading-relaxed text-muted-foreground"
        >
          <p>
            Playing with short poems, slide design experiments, and sketches for how to
            visually explain invisible things like energy flows and machine states.
          </p>
        </div>
      </Tabs>
    </div>
  </section>
</BaseLayout>
