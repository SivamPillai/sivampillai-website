---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedCollection } from "../lib/content";
import Headline from "../components/ui/Headline.astro";

const items = (await getPublishedCollection("collections")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const metadata = {
  title: "Collections",
  description:
    "Curated lists and themes — reading stacks, tool belts, and other bundles worth revisiting.",
};
---

<BaseLayout {metadata} section="Collections">
  <section class="px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="mx-auto max-w-5xl">
      <Headline
        tagline="Collections"
        title="Curated lists and themes"
        subtitle="Longer-lived bundles than a single note — reading stacks, references I send repeatedly, and ideas grouped on purpose."
        classes={{
          container: "mb-10 text-left",
          title:
            "font-heading mb-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle: "max-w-3xl text-base text-muted-foreground",
        }}
      />

      <div class="space-y-6">
        {
          items.map((entry) => {
            const slug =
              (entry as { id: string; slug?: string }).slug ?? entry.id;
            return (
              <article class="reveal rounded-2xl border border-border bg-card/60 p-5 transition-colors hover:border-primary/50">
                <h2 class="text-lg font-semibold text-foreground">
                  {entry.data.title}
                </h2>
                {entry.data.description && (
                  <p class="mt-1 text-sm text-muted-foreground">
                    {entry.data.description}
                  </p>
                )}
                <div class="mt-2 flex flex-wrap gap-2 text-xs text-muted-foreground">
                  <span>
                    {entry.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                  {Array.isArray(entry.data.tags) &&
                    entry.data.tags.map((tag) => (
                      <span class="rounded-full bg-foreground/5 px-3 py-1">
                        {tag}
                      </span>
                    ))}
                </div>
                <a
                  href={`/collections/${slug}`}
                  class="mt-3 inline-flex text-xs font-semibold text-primary hover:underline"
                >
                  Open collection
                </a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
