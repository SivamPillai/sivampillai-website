---
import BaseLayout from "../layouts/BaseLayout.astro";
import Headline from "../components/ui/Headline.astro";
import Tabs from "../components/ui/Tabs.astro";
import { getEntry } from "astro:content";
import { parseResourcesBody } from "../lib/parse-resources-body";

const metadata = {
  title: "Resources",
  description:
    "Books, tools, and links I keep recommending around AI systems, manufacturing, and thinking clearly.",
};

const entry = await getEntry("resources", "resources");
const parsed = entry?.body ? parseResourcesBody(entry.body) : { sections: [] };
const resourceTabs = parsed.sections.map((s) => ({ id: s.id, label: s.label }));

const p = (id: string) => `panel-resources-${id}`;
---

<BaseLayout {metadata}>
  <section class="px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="mx-auto max-w-4xl space-y-8">
      <Headline
        tagline="Resources"
        title="Things I keep pointing people to"
        subtitle="This page will grow slowly. For now it’s a small set of books, tools, and links that shape how I work."
        classes={{
          container: "mb-4 text-left",
          title:
            "font-heading mb-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle: "max-w-2xl text-sm text-muted-foreground",
        }}
      />

      {
        resourceTabs.length === 0 ? (
          <p class="text-sm text-muted-foreground">
            Resources are not configured yet. Add{" "}
            <code class="rounded bg-muted px-1 py-0.5 text-foreground">src/content/resources.md</code>{" "}
            with <code class="rounded bg-muted px-1 py-0.5 text-foreground">##</code> section headings.
          </p>
        ) : (
          <Tabs tabs={resourceTabs} idPrefix="resources">
            {parsed.sections.map((section) => (
              <div
                id={p(section.id)}
                data-tab-panel={section.id}
                class="text-sm text-muted-foreground"
              >
                {section.intro ? (
                  <p class="mb-4 whitespace-pre-line">{section.intro}</p>
                ) : null}
                {section.items.length === 0 && !section.intro ? (
                  <p>Nothing listed yet.</p>
                ) : section.items.length > 0 ? (
                  <ul class="space-y-4">
                    {section.items.map((item) => (
                      <li>
                        <div class="font-medium text-foreground">
                          {item.href && item.linkLabel === undefined ? (
                            <a
                              href={item.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="hover:underline"
                            >
                              {item.title}
                            </a>
                          ) : (
                            <span>{item.title}</span>
                          )}
                        </div>
                        {item.description ? (
                          <p class="mt-1 whitespace-pre-line text-muted-foreground">
                            {item.description}
                          </p>
                        ) : null}
                        {item.href && item.linkLabel !== undefined ? (
                          <p class="mt-1">
                            <a
                              href={item.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-foreground underline-offset-2 hover:underline"
                            >
                              {item.linkLabel}
                            </a>
                          </p>
                        ) : null}
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            ))}
          </Tabs>
        )
      }
    </div>
  </section>
</BaseLayout>
