---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedCollection } from "../../lib/content";
import { render, type CollectionEntry } from "astro:content";
import Headline from "../../components/ui/Headline.astro";
import RelatedContent from "../../components/thinking/RelatedContent.astro";

type CuratedEntry = CollectionEntry<"collections">;

export async function getStaticPaths() {
  const entries = await getPublishedCollection("collections");
  return entries.map((entry) => {
    const slug = (entry as { id: string; slug?: string }).slug ?? entry.id;
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props as { entry: CuratedEntry };
const { Content } = await render(entry);

const metadata = {
  title: entry.data.title,
  description: entry.data.description,
};
---

<BaseLayout {metadata} section="Collections">
  <article class="px-4 py-8 sm:px-6 lg:px-8 md:py-12">
    <div class="mx-auto max-w-3xl">
      <Headline
        tagline="Collection"
        title={entry.data.title}
        subtitle={entry.data.description}
        classes={{
          container: "mb-6 text-left",
          title:
            "font-heading mb-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle: "max-w-2xl text-base text-muted-foreground",
        }}
      />

      <div class="mb-4 flex flex-wrap gap-2 text-xs text-muted-foreground">
        <span>
          {
            entry.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          }
        </span>
        {
          Array.isArray(entry.data.tags) &&
            entry.data.tags.map((tag) => (
              <span class="rounded-full bg-foreground/5 px-3 py-1">{tag}</span>
            ))
        }
      </div>

      <div class="prose prose-invert max-w-none text-sm leading-relaxed">
        <Content />
      </div>

      <RelatedContent currentId={entry.id} tags={entry.data.tags} />
    </div>
  </article>
</BaseLayout>
