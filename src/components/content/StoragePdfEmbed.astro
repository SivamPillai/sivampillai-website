---
import { getStorageImageUrl } from "../../utils/storage";

interface Props {
  /** Logical storage path (same convention as `image`), e.g. public/essays/paper.pdf */
  path: string;
  /** Accessible document title for the iframe */
  title: string;
}

const { path, title: docTitle } = Astro.props;
const url = getStorageImageUrl(path);
---

{
  url && (
    <div class="reveal mb-8 w-full">
      <div class="relative h-96 w-full overflow-hidden rounded-xl shadow-lg bg-foreground/5">
        <iframe
          src={url}
          title={docTitle}
          class="h-full w-full border-0 bg-background"
          loading="lazy"
        />
      </div>
      <p class="mt-2 text-center text-sm text-muted-foreground">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary underline hover:opacity-90"
        >
          Open PDF
        </a>
      </p>
    </div>
  )
}
